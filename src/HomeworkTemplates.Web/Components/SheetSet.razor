@{
    var spec = Worksheet.Spec;
    var pageCount = Worksheet.Pages.Count;
    var showSeed = spec.Order == ProblemOrder.Shuffled;
}

@foreach (var page in Worksheet.Pages)
{
    var hiddenInPreview = VisiblePage != 0 && page.Number != VisiblePage;
    <section class="sheet @(ShowAnswers ? "answer-key-sheet" : "worksheet-sheet") @(hiddenInPreview ? "preview-hidden" : null)" style="@SheetStyle.For(spec.Page)">
        <WorksheetHeader Title="@(ShowAnswers ? $"Answer Key for {spec.Title}" : spec.Title)"
                         ShowNameAndDate="@(!ShowAnswers && spec.ShowNameAndDate)" />

        <div class="problem-grid @(spec.ShowGridLines ? "ruled" : null)" style="@SheetStyle.GridTemplate(spec.Page)">
            @foreach (var problem in page.Problems)
            {
                <div class="problem">
                    @if (ShowAnswers)
                    {
                        <span class="problem-text">@problem.Left &times; @problem.Right = @problem.Answer</span>
                    }
                    else
                    {
                        <span class="problem-text">@problem.Left &times; @problem.Right =</span>
                        <span class="answer-blank"></span>
                    }
                </div>
            }
        </div>

        <footer class="sheet-footer">
            @(showSeed ? $"Seed {spec.Seed}" : "")@(showSeed && pageCount > 1 ? " · " : "")@(pageCount > 1 ? $"Page {page.Number} of {pageCount}" : "")
        </footer>
    </section>
}

@code {
    [Parameter]
    public Worksheet Worksheet { get; set; } = default!;

    [Parameter]
    public bool ShowAnswers { get; set; }

    [Parameter]
    public int VisiblePage { get; set; }
}
