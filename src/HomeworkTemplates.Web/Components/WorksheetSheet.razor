<section class="sheet worksheet-sheet" style="@SheetStyle.For(Worksheet.Spec.Page)">
    <header class="sheet-header">
        <h2 class="sheet-title">@Worksheet.Spec.Title</h2>
        @if (Worksheet.Spec.ShowNameAndDate)
        {
            <p class="name-date">
                <span>Name: <span class="write-in"></span></span>
                <span>Date: <span class="write-in"></span></span>
            </p>
        }
    </header>

    <div class="problem-grid" style="@SheetStyle.GridColumns(Worksheet.Spec.Page)">
        @foreach (var problem in Worksheet.Problems)
        {
            <div class="problem">
                <span class="problem-text">@problem.Left &times; @problem.Right =</span>
                <span class="answer-blank"></span>
            </div>
        }
    </div>

    <footer class="sheet-footer">Seed @Worksheet.Spec.Seed</footer>
</section>

@code {
    [Parameter]
    public Worksheet Worksheet { get; set; } = default!;
}
